# Configuración Apache / DonWeb cPanel para Single Page Application (React / Vite)
# Permite que URLs directas como /operaciones/supervisoria/planificacion no den 404

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /operaciones/supervisoria/

  # Si el archivo o carpeta solicitado existe en el servidor, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta interna (ej: /planificacion) se redirige al index.html de la SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Tipos MIME correctos para módulos JavaScript, estilos y fuentes
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
